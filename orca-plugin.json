{
  "manifestVersion": 2,
  "id": "convert-viewer",
  "name": "Convert Viewer",
  "version": "0.1.0",
  "description": "Read legacy Office, OpenDocument, Visio, Publisher and iWork files as PDF (LibreOffice) and .blend scenes in 3D (Blender) in Orca's editor.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "customEditors": [
      {
        "id": "json",
        "title": "Tree",
        "extensions": [
          ".json",
          ".jsonc",
          ".geojson"
        ],
        "entry": "editor/entries/json.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      },
      {
        "id": "yaml",
        "title": "Tree",
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "entry": "editor/entries/yaml.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      },
      {
        "id": "toml",
        "title": "Tree",
        "extensions": [
          ".toml"
        ],
        "entry": "editor/entries/toml.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      },
      {
        "id": "xml",
        "title": "Tree",
        "extensions": [
          ".xml",
          ".plist"
        ],
        "entry": "editor/entries/xml.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      },
      {
        "id": "files-default-1",
        "title": "Viewer",
        "extensions": [
          ".doc",
          ".dot",
          ".ppt",
          ".pps",
          ".pot",
          ".odt",
          ".ott",
          ".odp",
          ".otp",
          ".odg",
          ".otg",
          ".vsd",
          ".vsdx",
          ".pub",
          ".wpd",
          ".wps",
          ".pages",
          ".numbers",
          ".pptx",
          ".pptm",
          ".ppsx",
          ".ppsm",
          ".potx",
          ".potm",
          ".blend",
          ".abc",
          ".jp2",
          ".wmv",
          ".flv",
          ".mpg",
          ".mpeg",
          ".3gp"
        ],
        "entry": "editor/entries/files.ts",
        "frame": "isolated",
        "contentKind": "bytes",
        "priority": "default"
      },
      {
        "id": "files-default-2",
        "title": "Viewer",
        "extensions": [
          ".mts",
          ".m2ts",
          ".vob",
          ".aiff",
          ".aif",
          ".caf",
          ".wma",
          ".amr"
        ],
        "entry": "editor/entries/files.ts",
        "frame": "isolated",
        "contentKind": "bytes",
        "priority": "default"
      }
    ]
  }
}
