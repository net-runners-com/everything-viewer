{
  "manifestVersion": 2,
  "id": "everything-viewer",
  "name": "Everything Viewer",
  "version": "0.1.0",
  "description": "Opens files nothing else in Orca shows: legacy Office, OpenDocument, Pages/Numbers and PowerPoint as pages (LibreOffice), Blender scenes in 3D, JPEG 2000, older video/audio (ffmpeg), and JSON/YAML/TOML/XML as a tree. Extensions are configured in formats.json.",
  "license": "MIT",
  "repository": "https://github.com/net-runners-com/everything-viewer",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "customEditors": [
      {
        "id": "json",
        "title": "Tree",
        "extensions": [
          ".json",
          ".jsonc",
          ".geojson"
        ],
        "entry": "editor/entries/json.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      },
      {
        "id": "yaml",
        "title": "Tree",
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "entry": "editor/entries/yaml.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      },
      {
        "id": "toml",
        "title": "Tree",
        "extensions": [
          ".toml"
        ],
        "entry": "editor/entries/toml.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      },
      {
        "id": "xml",
        "title": "Tree",
        "extensions": [
          ".xml",
          ".plist"
        ],
        "entry": "editor/entries/xml.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      },
      {
        "id": "files-default-1",
        "title": "Viewer",
        "extensions": [
          ".doc",
          ".dot",
          ".ppt",
          ".pps",
          ".pot",
          ".odt",
          ".ott",
          ".odp",
          ".otp",
          ".odg",
          ".otg",
          ".vsd",
          ".vsdx",
          ".pub",
          ".wpd",
          ".wps",
          ".pages",
          ".numbers",
          ".pptx",
          ".pptm",
          ".ppsx",
          ".ppsm",
          ".potx",
          ".potm"
        ],
        "entry": "editor/entries/files.ts",
        "frame": "isolated",
        "contentKind": "bytes",
        "priority": "default"
      },
      {
        "id": "files-default-2",
        "title": "Viewer",
        "extensions": [
          ".blend",
          ".abc",
          ".jp2",
          ".wmv",
          ".flv",
          ".mpg",
          ".mpeg",
          ".3gp",
          ".mts",
          ".m2ts",
          ".vob",
          ".aiff",
          ".aif",
          ".caf",
          ".wma",
          ".amr"
        ],
        "entry": "editor/entries/files.ts",
        "frame": "isolated",
        "contentKind": "bytes",
        "priority": "default"
      }
    ]
  },
  "cover": {
    "path": "assets/cover.png",
    "alt": "A PowerPoint deck shown as pages in Everything Viewer, with the current page and zoom in the toolbar"
  },
  "screenshots": [
    {
      "path": "assets/presentation.png",
      "alt": "A .pptx deck converted by LibreOffice and shown page by page",
      "caption": "PowerPoint, with page and zoom toolbar"
    },
    {
      "path": "assets/document.png",
      "alt": "A legacy Word .doc report with a table, shown as a page",
      "caption": "Legacy Office documents (.doc, .ppt, .odt, Pages, Numbers…)"
    },
    {
      "path": "assets/blender.png",
      "alt": "A Blender .blend scene with a monkey head, sphere, cube and torus on a floor grid",
      "caption": "Blender scenes in 3D"
    },
    {
      "path": "assets/tree.png",
      "alt": "A docker compose YAML file as an expanded, filterable tree",
      "caption": "JSON, YAML, TOML and XML as a tree"
    }
  ]
}
