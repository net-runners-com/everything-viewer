{
  "manifestVersion": 2,
  "id": "convert-viewer",
  "name": "Convert Viewer",
  "version": "0.1.0",
  "description": "Read legacy Office, OpenDocument, Visio, Publisher and iWork files as PDF (LibreOffice) and .blend scenes in 3D (Blender) in Orca's editor.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "customEditors": [
      {
        "id": "bytes-default-1",
        "title": "Viewer",
        "extensions": [
          ".doc",
          ".dot",
          ".ppt",
          ".pps",
          ".pot",
          ".odt",
          ".ott",
          ".odp",
          ".otp",
          ".odg",
          ".otg",
          ".vsd",
          ".vsdx",
          ".pub",
          ".wpd",
          ".wps",
          ".key",
          ".pages",
          ".numbers",
          ".blend",
          ".abc",
          ".jp2",
          ".wmv",
          ".flv",
          ".mpg",
          ".mpeg",
          ".3gp",
          ".mts",
          ".m2ts",
          ".vob",
          ".aiff",
          ".aif"
        ],
        "entry": "editor/main.ts",
        "frame": "isolated",
        "contentKind": "bytes",
        "priority": "default"
      },
      {
        "id": "bytes-default-2",
        "title": "Viewer",
        "extensions": [
          ".caf",
          ".wma",
          ".amr"
        ],
        "entry": "editor/main.ts",
        "frame": "isolated",
        "contentKind": "bytes",
        "priority": "default"
      },
      {
        "id": "bytes-option-1",
        "title": "Viewer",
        "extensions": [
          ".docx",
          ".docm",
          ".dotx",
          ".xlsx",
          ".xlsm",
          ".xlsb",
          ".xls",
          ".ods",
          ".pptx",
          ".pptm",
          ".ppsx",
          ".potx",
          ".pdf",
          ".stl",
          ".obj",
          ".fbx",
          ".ply",
          ".usd",
          ".usdz",
          ".usdc",
          ".usda",
          ".glb",
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp",
          ".avif",
          ".bmp",
          ".ico",
          ".apng",
          ".tif"
        ],
        "entry": "editor/main.ts",
        "frame": "isolated",
        "contentKind": "bytes",
        "priority": "option"
      },
      {
        "id": "bytes-option-2",
        "title": "Viewer",
        "extensions": [
          ".tiff",
          ".heic",
          ".heif",
          ".psd",
          ".mp4",
          ".m4v",
          ".mov",
          ".webm",
          ".ogv",
          ".mp3",
          ".wav",
          ".m4a",
          ".aac",
          ".ogg",
          ".oga",
          ".flac",
          ".opus",
          ".weba",
          ".mkv",
          ".avi",
          ".ttf",
          ".otf",
          ".woff",
          ".woff2"
        ],
        "entry": "editor/main.ts",
        "frame": "isolated",
        "contentKind": "bytes",
        "priority": "option"
      },
      {
        "id": "text-option-1",
        "title": "Preview",
        "extensions": [
          ".md",
          ".markdown",
          ".mdx",
          ".html",
          ".htm",
          ".xhtml",
          ".json",
          ".jsonc",
          ".geojson",
          ".yaml",
          ".yml",
          ".toml",
          ".xml",
          ".plist",
          ".csv",
          ".tsv",
          ".svg",
          ".ipynb"
        ],
        "entry": "editor/main.ts",
        "frame": "isolated",
        "contentKind": "text",
        "priority": "option"
      }
    ]
  }
}
